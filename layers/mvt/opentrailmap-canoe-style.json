{
    "version": 8,
    "sources": {
        "trails": {
            "type": "vector",
            "tiles": [
                "https://paddlemap-tiles-770576063346.northamerica-northeast2.run.app/waterways/{z}/{x}/{y}.mvt"
            ],
            "minzoom": 0,
            "maxzoom": 14
        }
    },
    "sprite": "https://paddlemap.net/dist/sprites/opentrailmap",
    "layers": [
        {
            "id": "waterways",
            "type": "line",
            "source": "trails",
            "source-layer": "trail",
            "minzoom": 5,
            "filter": [
                "any",
                [
                    "all",
                    ["has","waterway"],
                    ["in",["get","canoe"],["literal", ["yes", "permit", "designated", "permissive", "customers"]]]
                ],
                [
                    "all",
                    ["==", ["get", "waterway"], "canoe_pass"],
                    [
                        "!",
                        [
                            "any",
                            ["in", ["get", "canoe"], ["literal", ["no", "private", "discouraged"]]],
                            [
                                "all",
                                ["!", ["has", "canoe"]],
                                ["in", ["get", "boat"], ["literal", ["no", "private", "discouraged"]]]
                            ],
                            [
                                "all",
                                ["!", ["has", "canoe"]],
                                ["!", ["has", "boat"]],
                                ["in", ["get", "access"], ["literal", ["no", "private", "discouraged"]]]
                            ],
                            [
                                "all",
                                ["!", ["has", "canoe"]],
                                ["!", ["has", "boat"]],
                                ["!", ["has", "access"]],
                                ["in",["get", "tunnel"], "flooded"]  
                            ]                
                        ]
                    ]
                ]
            ],
            "layout": {
                "line-cap": "round",
                "line-join": "round"
            },
            "paint": {
                "line-dasharray": [2,6],
                "line-width": ["interpolate",["linear"],["zoom"],12,1,22,5],
                "line-color": "#426395"
            }
        },
        {
            "id": "paths",
            "type": "line",
            "source": "trails",
            "source-layer": "trail",
            "minzoom": 5,
            "filter": [
                "any",
                [
                    "all",
                    [
                        "any",
                        ["has","highway"],
                        ["==", ["get", "man_made"], "pier"],
                        ["has","railway"]
                    ],
                    ["in",["get","portage"],["literal",["yes", "permit", "designated", "permissive", "customers"]]]
                ],
                [
                    "all",
                    ["has","railway"],
                    ["in",["get","canoe"],["literal", ["yes", "permit", "designated", "permissive", "customers"]]]
                ]
            ],
            "layout": {
                "line-cap": "round",
                "line-join": "round"
            },
            "paint": {
                "line-dasharray": [2,6],
                "line-width": ["interpolate",["linear"],["zoom"],12,1,22,5 ],
                "line-color": "#4f2e28"
            }
        }
    ]
}